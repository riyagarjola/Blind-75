Input: a = 1, b = 2
Output: 3
Input: a = 2, b = 3
Output: 5

class Solution {
public:
    int getSum(int a, int b) {
    while(b!=0){
    int sum=a^b;
    int carry=(a & b) << 1;
    a=sum;
    b=carry;
    }
