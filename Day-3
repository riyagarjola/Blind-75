    trieNode* crawler=root;
    for(int i=0;i<word.length();i++){
    char ch=word[i];
    int idx=ch-'a';
    if(crawler->children[idx]==NULL){
        crawler->children[idx]=getNode();
    } 
    crawler=crawler->children[idx];   
    }
    crawler->isEndOfWord=true;
    }
    
    bool search(string word) {
    trieNode* crawler=root;
    for(int i=0;i<word.length();i++){
        char ch=word[i];
        int idx=ch-'a';
        if(crawler->children[idx]==NULL){
            return false;
