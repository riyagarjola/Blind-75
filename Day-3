class Trie {
public:
    struct trieNode{
        bool isEndOfWord;
        trieNode *children[26];
    };
    trieNode* getNode(){
        trieNode* newNode=new trieNode();
        newNode->isEndOfWord=false;
        for(int i=0;i<26;i++){
            newNode->children[i]=NULL;
        }
        return newNode;
    }
    trieNode* root;
    Trie() {
