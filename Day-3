Output: 0

class Solution {
public:
    int t[101];
    int solve(int i, string &s, int &n){
        if(i==n){
            return t[i]=1;  //one valid split done
        }
        if(s[i]=='0'){
            return t[i]=0;  // don't move forward not possible to split;
        }
        if(t[i]!=-1){
            return t[i];
        }

        int result=solve(i+1,s,n);
        if(i+1 < n){
            if(s[i]=='1' ||(s[i]=='2' && s[i+1]<='6')){
            result += solve(i+2,s,n);
            }
        }
        return t[i]=result;
    }
